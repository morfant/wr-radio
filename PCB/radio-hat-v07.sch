<package name="1X10_LOCK_LONGPADS" urn="urn:adsk.eagle:footprint:37786/2" library_version="2">
<description>&lt;h3&gt;Plated Through Hole -10 Pin Locking Footprint with Long Pads&lt;/h3&gt;
